# Backend (FastAPI service): only OPENAI_API_KEY is required.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Frontend (Chainlit service): URL of the backend API.
# For local dev: BACKEND_URL=http://localhost:8000
# On Railway: BACKEND_URL=http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:${{backend.PORT}}
BACKEND_URL=http://localhost:8000

# WhatsApp via Green API (optional). Leave blank to disable the WhatsApp adapter
# entirely — Chainlit keeps working unchanged either way.
# - INSTANCE_ID and API_TOKEN come from the Green API console after registering an instance.
# - WEBHOOK_TOKEN is a secret you invent; pass it as ?token=... in the webhook URL
#   you give to Green API, e.g.  https://<host>/webhook/whatsapp?token=<WEBHOOK_TOKEN>
GREENAPI_INSTANCE_ID=
GREENAPI_API_TOKEN=
GREENAPI_WEBHOOK_TOKEN=
